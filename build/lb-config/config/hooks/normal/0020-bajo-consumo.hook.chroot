#!/bin/sh
# CeiOS: perfil bajo consumo (los ficheros de sysctl y zramswap vienen de includes)
set -e
for s in avahi-daemon ModemManager cups bluetooth apt-daily.timer apt-daily-upgrade.timer; do
  systemctl disable "$s.service" >/dev/null 2>&1 || true
done
echo "CeiOS: servicios innecesarios desactivados (reactivar cups: sudo systemctl enable --now cups)."
